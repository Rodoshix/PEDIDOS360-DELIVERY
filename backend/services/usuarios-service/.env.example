# Copiar a .env.local y definir una contraseña local antes de iniciar Docker Compose.
# Valores exclusivos de desarrollo; no utilizar credenciales de AWS aquí.
DB_NAME=pedidos360_usuarios
DB_USERNAME=pedidos360_usuarios
DB_PASSWORD=replace-me
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/pedidos360_usuarios
