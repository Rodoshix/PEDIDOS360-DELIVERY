# Copiar a .env.local y definir una contraseña local antes de iniciar Docker Compose.
# Valores exclusivos de desarrollo; no utilizar credenciales de AWS aquí.
DB_NAME=pedidos360_usuarios
DB_USERNAME=pedidos360_usuarios
DB_PASSWORD=replace-me
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/pedidos360_usuarios

# Identidad simulada, deshabilitada por defecto. Requiere perfil local y loopback.
LOCAL_IDENTITY_ENABLED=false
LOCAL_TENANT_ID=11111111-1111-1111-1111-111111111111
LOCAL_OBJECT_ID=22222222-2222-2222-2222-222222222222
LOCAL_ROLES=CLIENTE

# JWT real v2: incompatible con LOCAL_IDENTITY_ENABLED=true.
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_FRONTEND_CLIENT_ID=

# #78: relay de consultas, desactivado hasta corte coordinado #70.
PEDIDOS360_RELAY_MODE=DISABLED
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=pedidos360
RABBITMQ_USERNAME=p360-usuarios-consumer
RABBITMQ_PASSWORD=
PEDIDOS360_ACTOR_KEY_ID=
PEDIDOS360_ACTOR_SECRET=
PEDIDOS360_QUERY_DEADLINE=5s
PEDIDOS360_ACTOR_TTL=4s
PEDIDOS360_RETRY_DELAY=1s
PEDIDOS360_CONFIRM_TIMEOUT=3s
PEDIDOS360_RECOVERY_BACKOFF=500ms
PEDIDOS360_ACTOR_CLOCK_SKEW=5s
