# Copiar a .env.local y definir una contraseña local antes de iniciar Docker Compose.
# Valores exclusivos de desarrollo; no utilizar credenciales de AWS aquí.
DB_NAME=pedidos360_pedidos
DB_USERNAME=pedidos360_pedidos
DB_PASSWORD=replace-me
DB_PORT=5435
DB_URL=jdbc:postgresql://localhost:5435/pedidos360_pedidos

# Identidad simulada, deshabilitada por defecto. Requiere perfil local y loopback.
LOCAL_IDENTITY_ENABLED=false
LOCAL_USER_ID=10
LOCAL_ROLES=CLIENTE
