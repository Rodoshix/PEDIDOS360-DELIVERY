# Copiar a .env.local y definir una contraseña local antes de iniciar Docker Compose.
# Valores exclusivos de desarrollo; no utilizar credenciales de AWS aquí.
DB_NAME=pedidos360_pagos
DB_USERNAME=pedidos360_pagos
DB_PASSWORD=replace-me
DB_PORT=5437
DB_URL=jdbc:postgresql://localhost:5437/pedidos360_pagos

# URL interna del servicio de pedidos (coordinación de confirmación).
PEDIDOS_SERVICE_URL=http://localhost:8085

# Identidad simulada, deshabilitada por defecto. Requiere perfil local y loopback.
LOCAL_IDENTITY_ENABLED=false
LOCAL_USER_ID=10
LOCAL_ROLES=CLIENTE

# Confirmacion via endpoint interno de Pedidos con token de aplicacion (worker en Entra).
PEDIDOS_INTERNO_ENABLED=false
