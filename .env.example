# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
VITE_AZURE_CLIENT_ID=replace-me
VITE_AZURE_TENANT_ID=replace-me
VITE_AZURE_REDIRECT_URI=http://localhost:5173
VITE_AZURE_API_SCOPE=api://replace-me/access_as_user

# Microsoft Entra ID / BFF
AZURE_TENANT_ID=replace-me
AZURE_CLIENT_ID=replace-me
AZURE_API_AUDIENCE=api://replace-me
AZURE_ISSUER_URI=https://login.microsoftonline.com/replace-me/v2.0

# PostgreSQL / RDS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pedidos360
DB_USERNAME=pedidos360
DB_PASSWORD=replace-me

# URLs internas de servicios
USUARIOS_SERVICE_URL=http://localhost:8081
RESTAURANTES_SERVICE_URL=http://localhost:8082
PRODUCTOS_SERVICE_URL=http://localhost:8083
CARRITO_SERVICE_URL=http://localhost:8084
PEDIDOS_SERVICE_URL=http://localhost:8085
PAGOS_SERVICE_URL=http://localhost:8086
REPARTIDORES_SERVICE_URL=http://localhost:8087
SEGUIMIENTO_SERVICE_URL=http://localhost:8088

# RabbitMQ (broker y vhost de negocio)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=pedidos360
RABBITMQ_USERNAME=replace-me
RABBITMQ_PASSWORD=replace-me

# Request/reply interno de consultas (EP2-12, issue #77)
# HTTP sigue siendo el transporte predeterminado. ACTIVE solo habilita el adaptador interno.
PEDIDOS360_RELAY_MODE=DISABLED
# BFF es solicitante; cada servicio consumidor usa SERVICE.
PEDIDOS360_RELAY_ROLE=BFF
PEDIDOS360_QUERY_DEADLINE=5s
# Debe ser menor que el plazo: un retry corto no renueva el deadline.
PEDIDOS360_ACTOR_TTL=4s
PEDIDOS360_RETRY_DELAY=1s
PEDIDOS360_CONFIRM_TIMEOUT=3s
PEDIDOS360_HANDOFF_BACKOFF=500ms
PEDIDOS360_HANDOFF_ATTEMPTS=2
PEDIDOS360_MAX_PENDING=1024
PEDIDOS360_MAX_BODY_BYTES=262144
# Clave del contexto de actor firmado. Nunca versionar valores reales.
PEDIDOS360_ACTOR_KEY_ID=replace-me
PEDIDOS360_ACTOR_SECRET=replace-me-minimo-32-caracteres
PEDIDOS360_ACTOR_CLOCK_SKEW=5s
# Destinos de respuesta que el BFF acepta publicar (colas funcionales).
PEDIDOS360_ACTOR_DESTINOS=p360.usuarios.consultas.q,p360.restaurantes.consultas.q,p360.productos.consultas.q,p360.pagos.consultas.q
