# Public additions to .env.example. Combine into an ignored .env.multihost.
# EXAMPLES ONLY: replace with verified private addresses before approval.
HOST_A_PRIVATE_IP=172.31.80.10
HOST_B_PRIVATE_IP=172.31.80.11
# Absolute directories, separately provisioned per host; never commit their contents.
AWS_TLS_DIR=/opt/pedidos360/tls
AWS_SECRETS_DIR=/opt/pedidos360/secrets
EP2_PRIVATE_DIR=/opt/pedidos360/private-ep2
# Host A only. Verify actual EBS identity and mount before any broker restart.
RABBITMQ_DATA_DIR=/mnt/pedidos360-rabbitmq
EP2_EXPECTED_FS_ID=REPLACE_AFTER_APPROVED_MOUNT
EP2_EXECUTION_SCOPE=PREPARED_ONLY
# This example deliberately does not authorize starting the broker.
