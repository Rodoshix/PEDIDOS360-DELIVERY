# Packaging only; existing REST/security policy remains unchanged.
# Context: backend/services/rabbit-admin-service (tests run outside this build).
FROM eclipse-temurin:21-jdk-alpine@sha256:6ea5548706b60ac0a602eaf48af74792cbab012d90e811ca8db6184b16b5c3d6 AS build
WORKDIR /build
COPY --from=maven-wrapper .mvn .mvn
COPY --from=maven-wrapper mvnw ./
COPY pom.xml ./
COPY src/main src/main
RUN sed -i 's/\r$//' mvnw
RUN --mount=type=cache,id=pedidos360-maven,target=/root/.m2,sharing=locked \
    sh mvnw -B -ntp -Dmaven.test.skip=true package
FROM eclipse-temurin:21-jre-alpine@sha256:974b08960c5d96694c780e65b2d5705268ab1e1ca1a0dd0caf4ba6c3fe34d699
RUN addgroup -S -g 10001 app && adduser -S -D -H -u 10001 -G app app
WORKDIR /app
COPY --from=build /build/target/rabbit-admin-service-0.0.1-SNAPSHOT.jar app.jar
USER 10001:10001
EXPOSE 8090
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
