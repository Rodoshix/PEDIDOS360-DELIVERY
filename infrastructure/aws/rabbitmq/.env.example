# Paths are examples/placeholders, not created/provisioned AWS resources.
EP2_EXECUTION_SCOPE=PREPARED_ONLY
EP2_BACKEND_NETWORK=pedidos360-aws_services
RABBITMQ_DATA_DIR=/opt/pedidos360/rabbitmq-data
EP2_PRIVATE_DIR=/opt/pedidos360/private-ep2
EP2_EXPECTED_VOLUME_ID=REPLACE_AFTER_APPROVED_EBS_CREATION
EP2_EXPECTED_FS_UUID=REPLACE_AFTER_APPROVED_FORMAT_AND_MOUNT
EP2_EXPECTED_FS_ID=REPLACE_WITH_STAT_FILESYSTEM_ID_ON_VERIFIED_EBS
EP2_MANAGEMENT_URL=https://p360-rabbitmq:15671/api/
EP2_CA_FILE=/opt/pedidos360/private-ep2/tls/ca.pem
EP2_SECRET_DIR=/opt/pedidos360/private-ep2/secrets
EP2_AMQP_TOOLS_IMAGE=REPLACE_WITH_LOCALLY_BUILT_AND_APPROVED_TOOLS_IMAGE
RABBITMQ_SIMPLE_RETRY_MS=1000
PEDIDOS360_COORDINATION_MODE=HTTP
PEDIDOS360_RELIABILITY_PLATFORM_READY=false
PEDIDOS360_RELAY_MODE=DISABLED
PEDIDOS360_DECLARE_TOPOLOGY=false
# Passwords/cookie are files in private/secrets; distinct ES256 JWK/JWKS in private/identity.
# Node.js 22+ validates identities offline before the startup probes (no HMAC fallback).
