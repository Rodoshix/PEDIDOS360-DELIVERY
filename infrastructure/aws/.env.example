# Valores publicos; completar .env.deploy (ignorado). Sin contrasenas.
# Ejemplo ECR: <cuenta>.dkr.ecr.us-east-1.amazonaws.com
IMAGE_REGISTRY=
# Usar SHA completo del commit, nunca latest; no reutilizar tags publicados.
IMAGE_TAG=
FRONTEND_ORIGIN=
# URL HTTPS de API Gateway con el prefijo de rutas acordado. No apuntar directo a EC2.
PUBLIC_API_BASE_URL=
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_FRONTEND_CLIENT_ID=
PAGOS_WORKER_CLIENT_ID=
# Endpoint DNS real RDS, sin puerto ni protocolo.
RDS_HOST=
AWS_TLS_DIR=./tls
AWS_SECRETS_DIR=./secrets
