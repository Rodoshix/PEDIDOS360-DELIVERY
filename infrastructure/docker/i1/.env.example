# Copiar a .env.local sin sobrescribir uno existente. Solo desarrollo local.
# La URI de retorno se deriva de I1_FRONTEND_PORT: http://localhost:5180.
# Debe estar registrada como SPA en Entra para probar un login real.
I1_FRONTEND_PORT=5180
I1_USUARIOS_PORT=8181
I1_CARRITO_PORT=8184

# Configuración pública incorporada al build. Nunca client secret ni token.
I1_ENTRA_CLIENT_ID=
I1_ENTRA_TENANT_ID=
I1_ENTRA_API_SCOPE=
# BFF futuro; NO es la dirección interna de Usuarios/Carrito.
I1_API_BASE_URL=http://localhost:8080

# Contraseñas locales distintas. Requeridas; sin valor predeterminado.
# Cambiarlas aquí NO rota credenciales de un volumen ya inicializado.
I1_USUARIOS_DB_PASSWORD=
I1_CARRITO_DB_PASSWORD=
