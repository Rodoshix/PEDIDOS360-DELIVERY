# Desarrollo local: URL del BFF de Spring Boot.
# Despliegue: reemplazar por la URL pública de AWS API Gateway.
VITE_API_BASE_URL=http://localhost:8080

# Identificadores públicos de los registros de Entra; no son secretos.
# Completar desde Información general de pedidos360-frontend y del directorio.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
# Ámbito completo de pedidos360-api: api://<client-id-de-la-api>/access_as_user
VITE_ENTRA_API_SCOPE=
# Nunca agregar un client secret, contraseña o token a variables VITE_*.
